VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_PUBLIC_APP_URL=https://vadmassage.com
VITE_API_BASE_URL=https://your-vercel-app.vercel.app

# Public bank-transfer details. VITE_BANK_* values are included in the frontend bundle.
# Use clearly fake values here only; put real values in local/Vercel environment config.
VITE_BANK_ACCOUNT_NAME=Example Massage Studio
VITE_BANK_NAME=Example Bank
VITE_BANK_SORT_CODE=00-00-00
VITE_BANK_ACCOUNT_NUMBER=00000000

EMAIL_PROVIDER=resend
RESEND_API_KEY=your-resend-api-key
SENDER_EMAIL=bookings@yourdomain.com
REPLY_TO_EMAIL=bookings@yourdomain.com
API_PORT=8787
FRONTEND_ORIGIN=http://127.0.0.1:5173
INTERNAL_API_SECRET=your-internal-api-secret

# Server-side bank-transfer details for email rendering.
# These must match the VITE_BANK_* production values, but are read by the server.
BANK_ACCOUNT_NAME=Example Massage Studio
BANK_NAME=Example Bank
BANK_SORT_CODE=00-00-00
BANK_ACCOUNT_NUMBER=00000000

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_TEST_CHAT_ID=your-telegram-chat-id
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret
VITE_TELEGRAM_BOT_URL=https://t.me/your_bot_username
